---
import Layout from '../layouts/Layout.astro';

const title = 'PolyCribs - San Luis Obispo Rental & Landlord Reviews';
const description = 'PolyCribs helps you find honest reviews of landlords and rental properties in San Luis Obispo. Read reviews from real tenants before signing your lease.';

const MAPS_KEY = import.meta.env.PUBLIC_GOOGLE_MAPS_KEY;
const mapsScriptSrc = MAPS_KEY
  ? `https://maps.googleapis.com/maps/api/js?key=${MAPS_KEY}&callback=initHomeMap`
  : '';
---

<Layout title={title} description={description} active="home">
  <section class="hero" id="search">
    <div aria-label="San Luis Obispo aerial view" class="hero__bg" role="img"></div>
    <div class="container hero__content">
      <h1 class="hero__headline">Find Your Off-Campus Solution</h1>
      <form action="/properties" class="search" method="get">
        <div class="search__pill">
          <input aria-label="Search properties" class="search__input" name="q" placeholder="Search by address, landlord, or property name..." type="text" />
          <div aria-hidden="true" class="search__divider"></div>
          <label class="search__label">
            <span class="sr-only">Price</span>
            <select class="search__select" name="price">
              <option value="">Price Range</option>
              <option value="0-1500">Under $1,500</option>
              <option value="1500-2000">$1,500 - $2,000</option>
              <option value="2000-2500">$2,000 - $2,500</option>
              <option value="2500-3000">$2,500 - $3,000</option>
              <option value="3000+">$3,000+</option>
            </select>
            <span aria-hidden="true" class="chev">▸</span>
          </label>
          <div aria-hidden="true" class="search__divider"></div>
          <label class="search__label">
            <span class="sr-only">Beds and baths</span>
            <select class="search__select" name="beds_baths">
              <option value="">Beds + Baths</option>
              <option value="studio">Studio</option>
              <option value="1_1">1 bed / 1 bath</option>
              <option value="2_1">2 bed / 1 bath</option>
              <option value="2_2">2 bed / 2 bath</option>
              <option value="3_2">3+ bed / 2+ bath</option>
            </select>
            <span aria-hidden="true" class="chev">▸</span>
          </label>
          <button aria-label="Search" class="search__go" type="submit">→</button>
        </div>
      </form>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section__title">Explore SLO Rentals</h2>
      <p class="section__sub">Browse rental listings across San Luis Obispo neighborhoods</p>
      <div aria-label="Map of SLO rentals" class="gmapwrap">
        <div aria-label="Google map showing San Luis Obispo rentals" class="gmap" id="homeGmap" role="application"></div>
      </div>
      <div aria-label="Most popular housing" class="popular-housing">
        <button class="popular-btn" data-spot="mustang" type="button">
          Mustang Village
          <span class="popular-meta">4.5★</span>
        </button>
        <button class="popular-btn" data-spot="downtownlofts" type="button">
          Downtown Lofts
          <span class="popular-meta">4.3★</span>
        </button>
        <button class="popular-btn" data-spot="lagunalake" type="button">
          Laguna Lake Townhomes
          <span class="popular-meta">3.8★</span>
        </button>
      </div>
    </div>
  </section>

  <section class="section section--muted">
    <div class="container">
      <h2 class="section__title">Top Rated Properties</h2>
      <p class="section__sub">Highest rated rentals in San Luis Obispo based on tenant reviews</p>
      <div class="cards">
        <article class="card" data-hood="calpoly">
          <div class="card__meta">
            <div>
              <h3 class="card__title">Mustang Village</h3>
              <p class="card__sub">24 Reviews</p>
            </div>
            <div class="rating rating--high"><span class="rating__num">4.5</span></div>
          </div>
          <div aria-label="Mustang Village apartments" class="card__img card__img--1" role="img"></div>
          <div class="card__tags">
            <span class="tag">Near Cal Poly</span>
            <span class="tag">Student Friendly</span>
          </div>
        </article>
        <article class="card" data-hood="downtown">
          <div class="card__meta">
            <div>
              <h3 class="card__title">Downtown Lofts</h3>
              <p class="card__sub">18 Reviews</p>
            </div>
            <div class="rating rating--high"><span class="rating__num">4.3</span></div>
          </div>
          <div aria-label="Downtown Lofts" class="card__img card__img--2" role="img"></div>
          <div class="card__tags">
            <span class="tag">Downtown</span>
            <span class="tag">Walkable</span>
          </div>
        </article>
        <article class="card" data-hood="laguna">
          <div class="card__meta">
            <div>
              <h3 class="card__title">Laguna Lake Townhomes</h3>
              <p class="card__sub">15 Reviews</p>
            </div>
            <div class="rating rating--med"><span class="rating__num">3.8</span></div>
          </div>
          <div aria-label="Laguna Lake Townhomes" class="card__img card__img--3" role="img"></div>
          <div class="card__tags">
            <span class="tag">Family Friendly</span>
            <span class="tag">Quiet</span>
          </div>
        </article>
      </div>
      <div class="cta-row">
        <a class="btn btn--outline" href="/properties">View All Properties</a>
      </div>
    </div>
  </section>

  <section class="section section--cta" id="reviews">
    <div class="container cta__inner">
      <div class="cta__text">
        <h2 class="cta__title">Share Your Experience</h2>
        <p class="cta__desc">Help fellow renters make informed decisions. Your honest review can save someone from a bad landlord or help them find a great one.</p>
        <a class="btn" href="/write-review">Write a Review</a>
      </div>
      <div class="cta__graphic">
        <div class="review-preview">
          <div class="review-preview__stars">★★★★☆</div>
          <p class="review-preview__text">"Great landlord, always responsive to maintenance requests. The apartment was clean and well-maintained..."</p>
          <span class="review-preview__author">- Recent SLO Tenant</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="about">
    <div class="container">
      <h2 class="section__title">How It Works</h2>
      <p class="section__sub">Finding the right rental in SLO shouldn't be a gamble</p>
      <div class="steps">
        <a class="step step--link" href="/properties">
          <h3 class="step__title">Search</h3>
          <p class="step__desc">Browse properties by location, price, or landlord name</p>
        </a>
        <a class="step step--link" href="/properties">
          <h3 class="step__title">Read Reviews</h3>
          <p class="step__desc">See honest feedback from current and past tenants</p>
        </a>
        <a class="step step--link" href="/write-review">
          <h3 class="step__title">Share</h3>
          <p class="step__desc">Write your own review to help the SLO community</p>
        </a>
      </div>
    </div>
  </section>

  <script>
    function initHomeMap() {
      const mapElement = document.getElementById('homeGmap');
      if (!mapElement || typeof google === 'undefined' || !google.maps) return;

      const map = new google.maps.Map(mapElement, {
        center: { lat: 35.2828, lng: -120.6596 },
        zoom: 13,
        mapTypeControl: false,
        streetViewControl: false,
        fullscreenControl: false,
      });

      const spots = {
        mustang: {
          name: 'Mustang Village',
          pos: { lat: 35.3026, lng: -120.6587 },
          details: 'Near Cal Poly • Student Friendly • 4.5★',
        },
        downtownlofts: {
          name: 'Downtown Lofts',
          pos: { lat: 35.2796, lng: -120.663 },
          details: 'Downtown • Walkable • 4.3★',
        },
        lagunalake: {
          name: 'Laguna Lake Townhomes',
          pos: { lat: 35.27, lng: -120.6832 },
          details: 'Quiet • Family Friendly • 3.8★',
        },
      };

      const greenPin = {
        path: google.maps.SymbolPath.CIRCLE,
        fillColor: '#1f5d2c',
        fillOpacity: 1,
        strokeColor: '#ffffff',
        strokeWeight: 3,
        scale: 9,
      };

      const info = new google.maps.InfoWindow();
      const markers = {};

      Object.entries(spots).forEach(([key, s]) => {
        const marker = new google.maps.Marker({
          map,
          position: s.pos,
          title: s.name,
          icon: greenPin,
        });

        markers[key] = marker;

        marker.addListener('click', () => {
          info.setContent(`<b>${s.name}</b><br/>${s.details}`);
          info.open(map, marker);
        });
      });

      document.querySelectorAll('.popular-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const key = btn.getAttribute('data-spot');
          const s = key ? spots[key] : null;
          const marker = key ? markers[key] : null;
          if (!s || !marker) return;

          map.panTo(s.pos);
          map.setZoom(14);
          info.setContent(`<b>${s.name}</b><br/>${s.details}`);
          info.open(map, marker);
        });
      });
    }

    window.initHomeMap = initHomeMap;
  </script>

  <script>
  function initHomeMap() {
    const mapElement = document.getElementById('homeGmap');
    if (!mapElement || typeof google === 'undefined' || !google.maps) return;

    const map = new google.maps.Map(mapElement, {
      center: { lat: 35.2828, lng: -120.6596 },
      zoom: 13,
      mapTypeControl: false,
      streetViewControl: false,
      fullscreenControl: false,
    });

    const spots = {
      mustang: {
        name: 'Mustang Village',
        pos: { lat: 35.3026, lng: -120.6587 },
        details: 'Near Cal Poly • Student Friendly • 4.5★',
      },
      downtownlofts: {
        name: 'Downtown Lofts',
        pos: { lat: 35.2796, lng: -120.663 },
        details: 'Downtown • Walkable • 4.3★',
      },
      lagunalake: {
        name: 'Laguna Lake Townhomes',
        pos: { lat: 35.27, lng: -120.6832 },
        details: 'Quiet • Family Friendly • 3.8★',
      },
    };

    const greenPin = {
      path: google.maps.SymbolPath.CIRCLE,
      fillColor: '#1f5d2c',
      fillOpacity: 1,
      strokeColor: '#ffffff',
      strokeWeight: 3,
      scale: 9,
    };

    const info = new google.maps.InfoWindow();
    const markers = {};

    Object.entries(spots).forEach(([key, s]) => {
      const marker = new google.maps.Marker({
        map,
        position: s.pos,
        title: s.name,
        icon: greenPin,
      });

      markers[key] = marker;

      marker.addListener('click', () => {
        info.setContent(`<b>${s.name}</b><br/>${s.details}`);
        info.open(map, marker);
      });
    });

    document.querySelectorAll('.popular-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.getAttribute('data-spot');
        const s = key ? spots[key] : null;
        const marker = key ? markers[key] : null;
        if (!s || !marker) return;

        map.panTo(s.pos);
        map.setZoom(14);
        info.setContent(`<b>${s.name}</b><br/>${s.details}`);
        info.open(map, marker);
      });
    });
  }

  function initHeroBackgroundSwap() {
    const heroBg = document.querySelector('.hero__bg');
    if (!heroBg) return;

    const images = [
      '/images/california_street.jpg',
      '/images/houses.jpg',
      '/images/beach.jpg',
    ];

    let index = 0;

    heroBg.style.backgroundImage = `url("${images[index]}")`;
    heroBg.style.backgroundSize = 'cover';
    heroBg.style.backgroundPosition = 'center';
    heroBg.style.backgroundRepeat = 'no-repeat';

    setInterval(() => {
      index = (index + 1) % images.length;
      heroBg.style.backgroundImage = `url("${images[index]}")`;
    }, 5000);
  }

  window.initHomeMap = initHomeMap;
  initHeroBackgroundSwap();
</script>

  {mapsScriptSrc && (
    <script
      async
      defer
      is:inline
      src={mapsScriptSrc}>
    </script>
  )}
</Layout>