---
import Layout from "../layouts/Layout.astro";
import Markdown from "../components/Markdown.astro";
import postgres from "postgres";

const explainer = `...`;

// Use Netlify-provided Neon connection string
const connectionString =
  import.meta.env.NETLIFY_DATABASE_URL ||
  import.meta.env.NETLIFY_DATABASE_URL_UNPOOLED ||
  process.env.NETLIFY_DATABASE_URL ||
  process.env.NETLIFY_DATABASE_URL_UNPOOLED;

if (!connectionString) throw new Error("Missing NETLIFY_DATABASE_URL");

const sql = postgres(connectionString, { ssl: "require" });

// adjust columns to match your schema
const listings = await sql`SELECT * FROM listings ORDER BY id DESC`;
---
