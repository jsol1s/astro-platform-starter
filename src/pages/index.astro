---
import Layout from "../layouts/Layout.astro";
import postgres from "postgres";
import Listings from '../components/Listings.astro';

const connectionString = import.meta.env.DATABASE_URL;
if (!connectionString) throw new Error("Missing DATABASE_URL");

const sql = postgres(connectionString, { ssl: "require" });
const listings = await sql`SELECT * FROM listings ORDER BY id DESC`;

const explainer = "This page fetches listings from Neon and displays them below.";
---

<Layout>
  <h1>Home Page</h1>
  <p>{explainer}</p>

  <Listings />

  <h2>Listings:</h2>
  <ul>
    {listings.map(listing => (
      <li>{listing.name} - ${listing.price}</li>
    ))}
  </ul>
</Layout>
