---
import Layout from '../layouts/Layout.astro';

const title = 'About PolyCribs';
const description = 'Learn about PolyCribs: a renter-first place to share honest landlord and property reviews in San Luis Obispo.';
---

<Layout title={title} description={description} active="about">
  <section class="page-hero">
    <div class="container page-hero__inner">
      <h1 class="page-hero__title">About PolyCribs</h1>
      <p class="page-hero__sub">
        PolyCribs is a renter-first website for San Luis Obispo. We make it easier to find rentals and avoid bad situations by sharing honest,
        experience-based reviews of landlords and properties.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container page-grid">
      <article class="panel">
        <h2 class="panel__title">Our mission</h2>
        <p class="panel__text">
          Renting in SLO can be stressful: you're making expensive decisions with limited information. PolyCribs exists to close that gap.
          We're building a community-driven place where tenants can share what it's really like to live somewhere — the good, the bad, and the
          “wish I knew that before.”
        </p>

        <div style="height:14px"></div>

        <h2 class="panel__title">How reviews work</h2>
        <p class="panel__text">
          Reviews are written by renters and focused on practical things: responsiveness, maintenance, deposit fairness, privacy/respect, noise,
          and overall experience. The goal is clarity, not drama.
        </p>

        <div style="height:14px"></div>

        <h2 class="panel__title">Fairness &amp; transparency</h2>
        <p class="panel__text">
          We encourage specifics (dates, timelines, outcomes) and discourage personal attacks. If you're writing a review, stick to what
          happened and what you'd want a friend to know.
        </p>

        <div class="cta-row" style="text-align:left; margin-top:18px">
          <a class="btn" href="/write-review">Write a Review</a>
          <a class="btn btn--outline" href="/#search" style="margin-left:10px">Browse Rentals</a>
        </div>
      </article>

      <aside class="panel">
        <h2 class="panel__title">What we care about</h2>
        <div class="kv">
          <div class="kv__row"><span class="kv__k">Honesty</span><span class="kv__v">Real experiences</span></div>
          <div class="kv__row"><span class="kv__k">Clarity</span><span class="kv__v">Useful details</span></div>
          <div class="kv__row"><span class="kv__k">Safety</span><span class="kv__v">Renter-first</span></div>
          <div class="kv__row"><span class="kv__k">Community</span><span class="kv__v">Help each other</span></div>
        </div>

        <div style="height:18px"></div>

        <h2 class="panel__title">Questions?</h2>
        <p class="panel__text">
          We're just getting started and would love to hear from you! If you have questions, feedback, or want to get involved, please reach out.
        </p>
      </aside>
    </div>
  </section>
</Layout>
