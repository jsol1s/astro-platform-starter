---
import Layout from '../layouts/Layout.astro';

const title = 'Image CDN';
const description = 'A reconstructed Astro demo page for comparing original images with optimized delivery.';

const astroImageSnippet = `---
import { Image } from 'astro:assets';
import corgi from '../assets/corgi.jpg';
---

<Image src={corgi} alt="Corgi" />`;

const originalVsCdnSnippet = `## Original vs. optimized image: can you tell the difference?

In the code below, a regular <img> tag is used in both cases for a framework-agnostic example.

~~~jsx
<img alt="Corgi" src="/images/corgi.jpg" />
<img alt="Corgi" sizes="(max-width: 900px) 100vw, 800px" srcset="/images/corgi.jpg 800w" />
~~~`;
---

<Layout title={title} description={description}>
  <section class="section">
    <div class="container" style="display:grid; gap:32px;">
      <section>
        <h1 class="section__title">Image CDN</h1>
        <p class="section__sub">This page was reconstructed into valid Astro from a broken mixed HTML/Astro source.</p>
      </section>

      <section class="panel">
        <h2 class="panel__title">Astro image example</h2>
        <pre style="white-space:pre-wrap; background:#111; color:#f5f5f5; padding:18px; border-radius:14px; overflow:auto;">{astroImageSnippet}</pre>
        <figure style="margin-top:18px;">
          <img alt="Corgi" class="border-2 border-white rounded-lg" src="/images/corgi.jpg" />
          <figcaption class="section__sub" style="margin-top:10px;">
            Credit: photo by Alvan Nee on Unsplash.
          </figcaption>
        </figure>
      </section>

      <section class="panel">
        <h2 class="panel__title">Original vs optimized example</h2>
        <pre style="white-space:pre-wrap; background:#111; color:#f5f5f5; padding:18px; border-radius:14px; overflow:auto;">{originalVsCdnSnippet}</pre>
        <div class="cards" style="margin-top:18px;">
          <article class="card">
            <div class="card__meta"><h3 class="card__title">Original image</h3></div>
            <img alt="Corgi original" data-size-label src="/images/corgi.jpg" />
          </article>
          <article class="card">
            <div class="card__meta"><h3 class="card__title">Optimized delivery</h3></div>
            <img alt="Corgi optimized" data-size-label src="/images/corgi.jpg" />
          </article>
        </div>
      </section>
    </div>
  </section>

  <script>
    const images = document.querySelectorAll('img[data-size-label]');

    images.forEach((image) => {
      if (image.complete) {
        showImageSize(image);
      } else {
        image.addEventListener('load', () => showImageSize(image));
      }
    });

    function showImageSize(image) {
      const entry = window?.performance?.getEntriesByName(image.currentSrc)?.[0];
      if (!entry || !entry.encodedBodySize) return;
      const label = document.createElement('div');
      label.className = 'section__sub';
      label.style.margin = '12px 18px 18px';
      label.textContent = `Loaded size: ${Math.ceil(entry.encodedBodySize / 1024)}KB`;
      image.parentElement.appendChild(label);
    }
  </script>
</Layout>
