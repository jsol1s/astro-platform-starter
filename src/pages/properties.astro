---
import Layout from "../layouts/Layout.astro";
import { neon } from "@netlify/neon";

const title = "PolyCribs - Rentals & Reviews in San Luis Obispo";
const description =
  "Browse reviewed rentals in San Luis Obispo. Filter by price, area, beds, and baths.";

let properties = [];
try {
  const sql = neon();
  properties = await sql`SELECT * FROM your_table_name ORDER BY id`;
} catch (err) {
  console.error("DB query failed:", err);
  properties = [];
}
---

<Layout title={title} description={description} active="properties">
  <!-- your HTML stays the same -->

  <!-- REMOVE data.js if you’re using DB data -->
  <script is:inline define:vars={{ properties }}>
    window.POLYCRIBS = window.POLYCRIBS || {};
    window.POLYCRIBS.PROPERTIES = properties;
  </script>

  <script>
    const PROPERTIES =
      window.POLYCRIBS && window.POLYCRIBS.PROPERTIES ? window.POLYCRIBS.PROPERTIES : [];
    // ...rest of your existing script...
  </script>

  <script async defer src="https://maps.googleapis.com/maps/api/js?key=AIzaSyAgv07mH0MrK1ch45I3MNLS87S6DEELllk&callback=initMap"></script>
</Layout>
