---
import Layout from '../layouts/Layout.astro';

const title = 'PolyCribs - Rentals & Reviews in San Luis Obispo';
const description = 'Browse reviewed rentals in San Luis Obispo. Filter by price, area, beds, and baths.';
---

<Layout title={title} description={description} active="properties">
  <section class="section">
    <div class="container">
      <h1 class="section__title">Browse Rentals</h1>
      <p class="section__sub">Explore places</p>

      <div aria-label="Property filters" class="filters" role="region">
        <input aria-label="Search by name or address" class="filters__input" id="q" placeholder="Search name or address…" type="text" />

        <label class="filters__label">
          <select aria-label="Filter by area" class="filters__select" id="area">
            <option value="">All areas</option>
            <option value="calpoly">Cal Poly Area</option>
            <option value="downtown">Downtown</option>
            <option value="laguna">Laguna Lake</option>
            <option value="irish">Irish Hills</option>
            <option value="johnson">Johnson Ave</option>
            <option value="broad">Broad Street</option>
            <option value="airport">SLO Airport Area</option>
          </select>
          <span aria-hidden="true" class="chev">▸</span>
        </label>

        <label class="filters__label">
          <select aria-label="Filter by price" class="filters__select" id="price">
            <option value="">Any price</option>
            <option value="0-1500">Under $1,500</option>
            <option value="1500-2000">$1,500 - $2,000</option>
            <option value="2000-2500">$2,000 - $2,500</option>
            <option value="2500-3000">$2,500 - $3,000</option>
            <option value="3000+">$3,000+</option>
          </select>
          <span aria-hidden="true" class="chev">▸</span>
        </label>

        <button class="filters__clear" id="clear" type="button">Clear</button>
      </div>

      <div aria-live="polite" class="resultsbar">
        <span id="count"></span>
      </div>

      <div class="plist" id="list" role="list"></div>
    </div>
  </section>

  <script>
    const PROPERTIES = [
      {
        id: 'chorro-001',
        name: 'Chorro Street House',
        address: '123 Chorro St, San Luis Obispo, CA',
        area: 'downtown',
        price: 2800,
        beds: 3,
        baths: 2,
        rating: 4.6,
        reviews: 5,
      },
    ];

    const els = {
      q: document.getElementById('q'),
      area: document.getElementById('area'),
      price: document.getElementById('price'),
      clear: document.getElementById('clear'),
      list: document.getElementById('list'),
      count: document.getElementById('count'),
    };

    function fmtMoney(n) {
      if (n === null || n === undefined || n === '') return '';
      return '$' + Number(n).toLocaleString('en-US', { maximumFractionDigits: 0 });
    }

    function areaLabel(key) {
      const map = {
        calpoly: 'Cal Poly Area',
        downtown: 'Downtown',
        laguna: 'Laguna Lake',
        irish: 'Irish Hills',
        johnson: 'Johnson Ave',
        broad: 'Broad Street',
        airport: 'SLO Airport Area',
      };
      return map[key] || key || '';
    }

    function matchText(p, q) {
      if (!q) return true;
      const t = q.trim().toLowerCase();
      const hay = ((p.name || '') + ' ' + (p.address || '')).toLowerCase();
      return hay.includes(t);
    }

    function inPriceRange(price, range) {
      if (!range) return true;
      if (range.endsWith('+')) {
        const min = parseInt(range.replace('+', ''), 10) || 0;
        return price >= min;
      }
      const parts = range.split('-');
      if (parts.length !== 2) return true;
      const lo = parseInt(parts[0], 10) || 0;
      const hi = parseInt(parts[1], 10) || 0;
      return price >= lo && price <= hi;
    }

    function filterProps() {
      const q = els.q.value;
      const area = els.area.value;
      const price = els.price.value;

      return PROPERTIES.filter((p) => {
        if (!matchText(p, q)) return false;
        if (area && p.area !== area) return false;
        if (!inPriceRange(p.price, price)) return false;
        return true;
      });
    }

    function render(list) {
      els.list.innerHTML = '';

      list.forEach((p) => {
        const item = document.createElement('article');
        item.className = 'pitem';
        item.setAttribute('role', 'listitem');

        item.innerHTML = `
          <a class="pitem__main pitem__link" href="/property?id=${encodeURIComponent(p.id)}">
            <div class="pitem__top">
              <h3 class="pitem__title">${p.name}</h3>
              <div class="pitem__pricewrap">
                <span class="pitem__price">${fmtMoney(p.price)}/mo</span>
              </div>
            </div>
            <div class="pitem__meta">
              <span class="pill">${areaLabel(p.area)}</span>
              <span class="pitem__addr">${p.address}</span>
            </div>
            <div class="pitem__meta2">
              <span class="pill pill--soft">${p.beds} bd · ${p.baths} ba</span>
              <span class="pitem__reviews">${p.reviews} review${p.reviews === 1 ? '' : 's'}</span>
            </div>
          </a>
          <div class="pitem__side">
            <div class="pitem__rating" aria-label="Rating ${p.rating} out of 5">
              <span class="pitem__ratingnum">${Number(p.rating).toFixed(1)}</span>
              <span class="pitem__stars">${'★'.repeat(Math.floor(p.rating))}</span>
            </div>
            <a class="btn btn--outline pitem__btn" href="/write-review?property=${encodeURIComponent(p.name)}&address=${encodeURIComponent(p.address)}">
              Write a review
            </a>
          </div>
        `;

        els.list.appendChild(item);
      });

      els.count.textContent = list.length === 1 ? 'Showing 1 place' : `Showing ${list.length} places`;
    }

    function refresh() {
      render(filterProps());
    }

    els.q.addEventListener('input', refresh);
    els.area.addEventListener('change', refresh);
    els.price.addEventListener('change', refresh);

    els.clear.addEventListener('click', () => {
      els.q.value = '';
      els.area.value = '';
      els.price.value = '';
      refresh();
    });

    refresh();
  </script>
</Layout>
