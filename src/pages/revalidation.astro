---
import Layout from '../layouts/Layout.astro';

const title = 'Revalidating Server Content';
const description = 'A reconstructed Astro demo page for invalidating cache tags.';
const exampleTag = 'properties';
const explainer = 'This page demonstrates a simple client-side POST to an /api/revalidate endpoint so you can manually invalidate cached content by tag.';
---

<Layout title={title} description={description}>
  <section class="section">
    <div class="container" style="display:grid; gap:18px;">
      <h1 class="section__title">Revalidating Server Content</h1>
      <p class="section__sub">{explainer}</p>
      <div style="display:flex; flex-wrap:wrap; gap:16px;">
        <button class="revalidate-button btn" data-tag={exampleTag}>Invalidate tag: {exampleTag}</button>
        <button class="btn" onclick="location.reload()">Reload page</button>
      </div>
    </div>
  </section>

  <script>
    async function revalidate(tag) {
      try {
        await fetch('/api/revalidate', {
          method: 'POST',
          body: JSON.stringify({ tags: [tag] }),
          headers: {
            'Content-Type': 'application/json',
          },
        });
        alert(`Invalidated tag: ${tag}`);
      } catch (error) {
        console.error(error);
        alert('Revalidation request failed.');
      }
    }

    const revalidateButton = document.querySelector('.revalidate-button');
    revalidateButton?.addEventListener('click', (e) => {
      const tag = e.currentTarget?.getAttribute('data-tag');
      if (!tag) return;
      revalidate(tag);
    });
  </script>
</Layout>
