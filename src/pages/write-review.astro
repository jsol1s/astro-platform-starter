---
import Layout from '../layouts/Layout.astro';

const title = 'Write a Review - PolyCribs';
const description = 'Write a rental review on PolyCribs. Help SLO renters make better decisions with honest, detailed feedback.';
---

<Layout title={title} description={description} active="write-review">
  <section class="page-hero">
    <div class="container page-hero__inner">
      <h1 class="page-hero__title">Write a Review</h1>
      <p class="page-hero__sub">
        Help other renters in San Luis Obispo. Keep it factual, specific, and useful — what happened, how long it took, and how it ended.
      </p>
      <div aria-label="Form completion progress" class="progress">
        <div class="progress__bar" id="progressBar"></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container page-grid">
      <article class="panel">
        <h2 class="panel__title">Review details</h2>
        <form class="form" id="reviewForm" novalidate>
          <div class="form-row">
            <div class="field">
              <label class="field__label" for="property">Property name</label>
              <input class="field__control" id="property" name="property" placeholder="e.g., Mustang Village" required />
              <p class="field__hint">If you only know the address, that's fine.</p>
              <p class="error-msg" hidden id="err_property">Please enter a property name.</p>
            </div>
            <div class="field">
              <label class="field__label" for="address">Address (optional)</label>
              <input class="field__control" id="address" name="address" placeholder="e.g., 123 Foothill Blvd" />
              <p class="field__hint">Don't include unit numbers if you don't want to.</p>
            </div>
          </div>

          <div class="form-row">
            <div class="field">
              <label class="field__label" for="landlord">Landlord / management</label>
              <input class="field__control" id="landlord" name="landlord" placeholder="e.g., ABC Property Mgmt" required />
              <p class="error-msg" hidden id="err_landlord">Please enter a landlord or management name.</p>
            </div>
            <div class="field">
              <label class="field__label">Rating</label>
              <div aria-label="Star rating" class="stars" role="group">
                <button aria-pressed="false" class="starbtn" data-star="1" type="button">★</button>
                <button aria-pressed="false" class="starbtn" data-star="2" type="button">★</button>
                <button aria-pressed="false" class="starbtn" data-star="3" type="button">★</button>
                <button aria-pressed="false" class="starbtn" data-star="4" type="button">★</button>
                <button aria-pressed="false" class="starbtn" data-star="5" type="button">★</button>
                <span id="ratingLabel" style="font-weight:850; color: var(--gold);">No rating</span>
              </div>
              <input id="rating" name="rating" required type="hidden" />
              <p class="error-msg" hidden id="err_rating">Please choose a rating.</p>
            </div>
          </div>

          <div class="field">
            <label class="field__label" for="review">Your review</label>
            <textarea class="field__control" id="review" name="review" placeholder="What went well? What went wrong? How was maintenance? Deposit return? Communication?" required rows="7"></textarea>
            <p class="field__hint">Aim for specifics. Example: “Hot water took 10 days to fix, multiple follow-ups, resolved after contacting…”</p>
            <p class="error-msg" hidden id="err_review">Please write a review (at least 40 characters).</p>
          </div>

          <div class="form-row">
            <div class="field">
              <label class="field__label" for="moveout">When was this?</label>
              <select class="field__control" id="moveout" name="when" required>
                <option value="">Select</option>
                <option>Within the last month</option>
                <option>Last 3 months</option>
                <option>Last 6 months</option>
                <option>Last year</option>
                <option>More than a year ago</option>
              </select>
              <p class="error-msg" hidden id="err_when">Please select when this happened.</p>
            </div>
            <div class="field">
              <label class="field__label" for="verified">
                <input id="verified" name="verified" type="checkbox" />
                Verified tenant (I lived here)
              </label>
              <p class="field__hint"></p>
            </div>
          </div>

          <div class="cta-row" style="text-align:left">
            <button class="btn" type="submit">Submit Review</button>
            <button class="btn btn--outline" id="saveDraft" style="margin-left:10px" type="button">Save draft</button>
          </div>
        </form>
      </article>

      <aside class="panel">
        <h2 class="panel__title">Quick guidelines</h2>
        <p class="panel__text">Keep it useful for renters:</p>
        <div class="kv">
          <div class="kv__row"><span class="kv__k">Do</span><span class="kv__v">Be specific &amp; factual</span></div>
          <div class="kv__row"><span class="kv__k">Do</span><span class="kv__v">Mention timelines/outcomes</span></div>
          <div class="kv__row"><span class="kv__k">Don't</span><span class="kv__v">Post private info</span></div>
          <div class="kv__row"><span class="kv__k">Don't</span><span class="kv__v">Use personal attacks</span></div>
        </div>

        <div style="height:18px"></div>

        <h2 class="panel__title">What happens when you submit?</h2>
        <p class="panel__text">
          Your review will be saved and displayed on the property page. It helps other renters make informed decisions and holds landlords accountable.
        </p>
      </aside>
    </div>
  </section>

  <script>
    const params = new URLSearchParams(window.location.search);
    const pName = params.get('property') || '';
    const pAddr = params.get('address') || '';
    const propertyInput = document.getElementById('property');
    const addressInput = document.getElementById('address');
    const ratingInput = document.getElementById('rating');
    const ratingLabel = document.getElementById('ratingLabel');
    const progressBar = document.getElementById('progressBar');
    const reviewForm = document.getElementById('reviewForm');
    const saveDraftBtn = document.getElementById('saveDraft');
    const starButtons = Array.from(document.querySelectorAll('.starbtn'));

    if (propertyInput && pName) propertyInput.value = pName;
    if (addressInput && pAddr) addressInput.value = pAddr;

    function updateStars(value) {
      starButtons.forEach((btn, idx) => {
        const active = idx < value;
        btn.setAttribute('aria-pressed', active ? 'true' : 'false');
        btn.style.opacity = active ? '1' : '0.45';
      });
      ratingLabel.textContent = value ? `${value} / 5` : 'No rating';
      ratingInput.value = value ? String(value) : '';
      updateProgress();
    }

    starButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        updateStars(Number(btn.getAttribute('data-star')) || 0);
      });
    });

    function updateProgress() {
      const fields = [
        document.getElementById('property'),
        document.getElementById('landlord'),
        document.getElementById('review'),
        document.getElementById('moveout'),
        document.getElementById('rating'),
      ];
      const filled = fields.filter((field) => field && field.value && String(field.value).trim().length > 0).length;
      const pct = Math.round((filled / fields.length) * 100);
      progressBar.style.width = `${pct}%`;
    }

    ['property', 'landlord', 'review', 'moveout'].forEach((id) => {
      const el = document.getElementById(id);
      el?.addEventListener('input', updateProgress);
      el?.addEventListener('change', updateProgress);
    });

    function setError(id, show) {
      const el = document.getElementById(id);
      if (el) el.hidden = !show;
    }

    reviewForm?.addEventListener('submit', async (e) => {
      e.preventDefault();

      const property = propertyInput.value.trim();
      const landlord = document.getElementById('landlord').value.trim();
      const review = document.getElementById('review').value.trim();
      const when = document.getElementById('moveout').value.trim();
      const rating = ratingInput.value.trim();

      setError('err_property', !property);
      setError('err_landlord', !landlord);
      setError('err_review', review.length < 40);
      setError('err_when', !when);
      setError('err_rating', !rating);

      if (property && landlord && review.length >= 40 && when && rating) {
        const data = {
          property,
          address: addressInput.value.trim(),
          landlord,
          rating,
          review,
          when,
          verified: document.getElementById('verified').checked
        };

        try {
          const res = await fetch('/api/reviews', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify(data),
          });

          if (!res.ok) {
            throw new Error('Failed to submit review');
          }

          alert('Review submitted!');
          localStorage.removeItem('polycribs-review-draft');
          reviewForm.reset();
          updateStars(0);
          updateProgress();
        } catch (err) {
          console.error(err);
          alert('There was a problem submitting your review.');
        }
      }
    });

    saveDraftBtn?.addEventListener('click', () => {
      const draft = {
        property: propertyInput?.value || '',
        address: addressInput?.value || '',
        landlord: document.getElementById('landlord')?.value || '',
        rating: ratingInput?.value || '',
        review: document.getElementById('review')?.value || '',
        when: document.getElementById('moveout')?.value || '',
      };
      localStorage.setItem('polycribs-review-draft', JSON.stringify(draft));
      alert('Draft saved locally in this browser.');
    });

    const savedDraft = localStorage.getItem('polycribs-review-draft');
    if (savedDraft) {
      try {
        const draft = JSON.parse(savedDraft);
        if (!propertyInput.value) propertyInput.value = draft.property || '';
        if (!addressInput.value) addressInput.value = draft.address || '';
        document.getElementById('landlord').value = draft.landlord || '';
        document.getElementById('review').value = draft.review || '';
        document.getElementById('moveout').value = draft.when || '';
        updateStars(Number(draft.rating || 0));
      } catch {
        // ignore invalid local draft
      }
    }

    updateStars(Number(ratingInput.value || 0));
    updateProgress();
  </script>
</Layout>