---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  active?: 'home' | 'properties' | 'write-review' | 'about';
}

const {
  title = 'PolyCribs',
  description = 'PolyCribs',
  active,
} = Astro.props;

const navHref = {
  home: '/',
  properties: '/properties',
  'write-review': '/write-review',
  about: '/about',
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" sizes="64x64" href="/images/PolyCribsLogo.png" />
    <link rel="apple-touch-icon" href="/images/PolyCribsLogo.png" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap" rel="stylesheet">
  </head>
  <body>
    <div class="coming-soon">
      🚧 PolyCribs is currently a prototype &mdash; features do not work yet.
    </div>

    <header class="topbar">
      <div class="container topbar__inner">
        <a class="brand" href={navHref.home}>
          <img alt="PolyCribs logo" class="brand__logo" src="/images/polycribs_logo-png.png" />
          <span class="brand__name">PolyCribs</span>
        </a>

        <nav class="nav">
          <a aria-current={active === 'properties' ? 'page' : undefined} class="nav__link" href={navHref.properties}>Find Rentals</a>
          <span class="nav__sep">|</span>
          <a aria-current={active === 'write-review' ? 'page' : undefined} class="nav__link" href={navHref['write-review']}>Write a Review</a>
          <span class="nav__sep">|</span>
          <a aria-current={active === 'about' ? 'page' : undefined} class="nav__link" href={navHref.about}>About</a>
          <button aria-label="Open menu" class="menu" title="Menu">
            <span></span><span></span><span></span>
          </button>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="container footer__inner">
        <div class="footer__brand">
          <img alt="PolyCribs logo" src="/images/polycribs_logo-png.png" style="height:65px;" />
          <span>PolyCribs</span>
        </div>
        <div class="footer__copy">
          &copy; <span id="year"></span> polycribs.com &mdash; All rights reserved.
        </div>
      </div>
    </footer>

    <script>
      document.getElementById('year').textContent = String(new Date().getFullYear());

      let lastScroll = 0;
      const topbar = document.querySelector('.topbar');

      window.addEventListener('scroll', () => {
        if (!topbar) return;
        const y = window.pageYOffset || document.documentElement.scrollTop;
        topbar.style.transform = y > lastScroll && y > 80 ? 'translateY(-100%)' : 'translateY(0)';
        lastScroll = y;
      });
    </script>
  </body>
</html>
